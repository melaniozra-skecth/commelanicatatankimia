<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tombolMateri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Materi" />

            <Button
                android:id="@+id/tombolTabelPeriodik"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Tabel Periodik" />

            <Button
                android:id="@+id/tombolPraktikum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Praktikum" />

            <Button
                android:id="@+id/tombolKuis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kuis" />

        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/judulHalaman"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Catatan Kimia"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/isiHalaman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih menu di atas untuk melihat isi catatan."
            android:textSize="16sp" />
    </ScrollView>

</LinearLayout>
